{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumi external data provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "status", "sources"],
  "properties": {
    "manifest_version": {"const": 1},
    "status": {"enum": ["empty", "reviewing", "approved_sources_present"]},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "empty"}}},
      "then": {"properties": {"sources": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["reviewing", "approved_sources_present"]}}},
      "then": {"properties": {"sources": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "source_type", "name", "canonical_identifier",
        "authors_or_organization", "version", "revision", "release_date",
        "access_date", "license", "permissions", "lumi_uses", "decision",
        "direct_or_indirect", "transformations", "filters", "deduplication",
        "document_count", "example_count", "token_count", "checksum",
        "review", "generation_record_id"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["external_dataset", "synthetic", "manually_authored", "public_metadata", "other"]},
        "name": {"type": "string", "minLength": 1},
        "canonical_identifier": {"type": "string", "minLength": 1},
        "authors_or_organization": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "release_date": {"type": ["string", "null"], "format": "date"},
        "access_date": {"type": "string", "format": "date"},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "url", "copyright_notice", "attribution_requirement", "terms_review"],
          "properties": {
            "identifier": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"},
            "copyright_notice": {"type": "string"},
            "attribution_requirement": {"type": "string"},
            "terms_review": {"type": "string", "minLength": 1}
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commercial_use", "redistribution", "modification", "derivative_works", "training_use", "evaluation_use"],
          "properties": {
            "commercial_use": {"$ref": "#/$defs/permission"},
            "redistribution": {"$ref": "#/$defs/permission"},
            "modification": {"$ref": "#/$defs/permission"},
            "derivative_works": {"$ref": "#/$defs/permission"},
            "training_use": {"$ref": "#/$defs/permission"},
            "evaluation_use": {"$ref": "#/$defs/permission"}
          }
        },
        "lumi_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["tokenizer_training", "pretraining", "instruction_training", "zenstream_specific_training", "evaluation", "filtering", "generation", "other"]}
        },
        "decision": {"enum": ["review_pending", "approved_for_use", "excluded"]},
        "direct_or_indirect": {"enum": ["direct", "indirect"]},
        "transformations": {"type": "array", "items": {"type": "string"}},
        "filters": {"type": "array", "items": {"type": "string"}},
        "deduplication": {"type": "array", "items": {"type": "string"}},
        "document_count": {"type": ["integer", "null"], "minimum": 0},
        "example_count": {"type": ["integer", "null"], "minimum": 0},
        "token_count": {"type": ["integer", "null"], "minimum": 0},
        "checksum": {"type": ["string", "null"], "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewed_by", "reviewed_date", "rationale"],
          "properties": {
            "reviewed_by": {"type": "string", "minLength": 1},
            "reviewed_date": {"type": "string", "format": "date"},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "generation_record_id": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"source_type": {"const": "synthetic"}}},
          "then": {"properties": {"generation_record_id": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"decision": {"const": "approved_for_use"}}},
          "then": {
            "properties": {
              "permissions": {
                "properties": {
                  "commercial_use": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                  "redistribution": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                  "modification": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                  "derivative_works": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                  "training_use": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                  "evaluation_use": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]}
                }
              }
            }
          }
        }
      ]
    },
    "permission": {"enum": ["permitted", "prohibited", "conditional", "unknown", "not_applicable"]}
  }
}
