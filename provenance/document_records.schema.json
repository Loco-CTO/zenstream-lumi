{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumi sample-level provenance record",
  "description": "One metadata-only record per exact text sample used in a Lumi data build. The text itself is stored separately under its applicable source and privacy controls.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "sample_kind",
    "sample_sha256",
    "language_tags",
    "lumi_uses",
    "decision",
    "split",
    "contamination_status",
    "privacy_status",
    "source_items",
    "transformations",
    "parent_record_ids",
    "review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "sample_kind": {"enum": ["external_document", "transformed_sample", "manually_authored", "synthetic"]},
    "sample_sha256": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
    "language_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "lumi_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["tokenizer_training", "pretraining", "instruction_training", "zenstream_specific_training", "evaluation", "filtering", "generation", "other"]}
    },
    "decision": {"enum": ["review_pending", "approved_for_use", "excluded"]},
    "split": {"enum": ["unassigned", "train", "development", "public_test", "sealed_holdout", "excluded"]},
    "contamination_status": {"enum": ["not_checked", "checked_clear", "known_overlap", "excluded"]},
    "privacy_status": {"enum": ["not_reviewed", "cleared", "redacted", "excluded"]},
    "source_items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceItem"}
    },
    "transformations": {
      "type": "array",
      "items": {"$ref": "#/$defs/transformation"}
    },
    "parent_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "generator": {"$ref": "#/$defs/generator"},
    "author_consent_record_id": {"type": "string", "minLength": 1},
    "review": {"$ref": "#/$defs/review"}
  },
  "allOf": [
    {
      "if": {"properties": {"sample_kind": {"const": "synthetic"}}, "required": ["sample_kind"]},
      "then": {"required": ["generator"]}
    },
    {
      "if": {"properties": {"sample_kind": {"const": "manually_authored"}}, "required": ["sample_kind"]},
      "then": {"required": ["author_consent_record_id"]}
    },
    {
      "if": {"properties": {"decision": {"const": "approved_for_use"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "contamination_status": {"const": "checked_clear"},
          "privacy_status": {"enum": ["cleared", "redacted"]},
          "source_items": {
            "items": {
              "properties": {
                "rights_basis": {"enum": ["license", "public_domain", "direct_permission"]},
                "rights_review_status": {"const": "reviewed"},
                "rights_reviewed_date": {"type": "string", "format": "date"},
                "permissions": {
                  "properties": {
                    "training_use": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                    "commercial_use": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                    "modification": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]},
                    "redistribution": {"enum": ["permitted", "prohibited", "conditional", "not_applicable"]}
                  }
                }
              }
            }
          },
          "review": {"properties": {"reviewed_date": {"type": "string", "format": "date"}}}
        }
      }
    }
  ],
  "$defs": {
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "item_id",
        "source_uri",
        "source_revision",
        "source_sha256",
        "rights_basis",
        "license_identifier",
        "license_uri",
        "rights_evidence_uris",
        "rights_review_status",
        "rights_reviewed_date",
        "permissions",
        "attribution"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "source_uri": {"type": ["string", "null"], "format": "uri"},
        "source_revision": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "rights_basis": {"enum": ["license", "public_domain", "direct_permission", "other", "unknown"]},
        "license_identifier": {"type": "string", "minLength": 1},
        "license_uri": {"type": ["string", "null"], "format": "uri"},
        "rights_evidence_uris": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "format": "uri"}
        },
        "rights_review_status": {"enum": ["pending", "reviewed", "excluded"]},
        "rights_reviewed_date": {"type": ["string", "null"], "format": "date"},
        "permissions": {"$ref": "#/$defs/permissions"},
        "attribution": {"type": "string"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_use", "commercial_use", "modification", "redistribution"],
      "properties": {
        "training_use": {"$ref": "#/$defs/permission"},
        "commercial_use": {"$ref": "#/$defs/permission"},
        "modification": {"$ref": "#/$defs/permission"},
        "redistribution": {"$ref": "#/$defs/permission"}
      }
    },
    "permission": {"enum": ["permitted", "prohibited", "conditional", "unknown", "not_applicable"]},
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "revision", "config_sha256"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "config_sha256": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_or_tool", "version", "prompt_template_id", "prompt_template_sha256"],
      "properties": {
        "model_or_tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "prompt_template_id": {"type": "string", "minLength": 1},
        "prompt_template_sha256": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_by", "reviewed_date", "rationale"],
      "properties": {
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_date": {"type": ["string", "null"], "format": "date"},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
