{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumi behavioral evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "family_id",
    "split",
    "review_status",
    "language",
    "categories",
    "turns",
    "trusted_context",
    "tool_scenario",
    "gold",
    "provenance_record_id",
    "review"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "case_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["development", "final_holdout"]},
    "review_status": {"enum": ["draft", "ready", "excluded"]},
    "language": {"enum": ["en", "ja", "en_ja"]},
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "trusted_context": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/trustedContext"}
      ]
    },
    "tool_scenario": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/toolScenario"}
      ],
      "description": "Optional deterministic fixture-only tool interface and ordered result fixtures. This is never an executable service connection."
    },
    "gold": {"$ref": "#/$defs/semanticOutput"},
    "provenance_record_id": {"type": "string", "minLength": 1},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_status", "language_review_status", "reviewer_ids", "review_record_ids"],
      "properties": {
        "annotation_status": {"enum": ["pending", "approved"]},
        "language_review_status": {"enum": ["not_required", "pending", "approved"]},
        "review_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "description": "IDs of the current independent review records in the controlled ledger."
        },
        "reviewer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "ready"}}, "required": ["review_status"]},
      "then": {
        "properties": {
          "review": {
            "properties": {
              "annotation_status": {"const": "approved"},
              "review_record_ids": {"minItems": 2},
              "reviewer_ids": {"minItems": 2}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {"const": "ready"},
          "language": {"enum": ["ja", "en_ja"]}
        },
        "required": ["review_status", "language"]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "language_review_status": {"const": "approved"},
              "review_record_ids": {"minItems": 3},
              "reviewer_ids": {"minItems": 3}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"language": {"const": "en"}}, "required": ["language"]},
      "then": {"properties": {"review": {"properties": {"language_review_status": {"enum": ["not_required", "approved"]}}}}}
    },
    {
      "if": {"properties": {"tool_scenario": {"type": "object"}}, "required": ["tool_scenario"]},
      "then": {"properties": {"gold": {"required": ["tool_trajectory"]}}},
      "else": {"properties": {"gold": {"not": {"required": ["tool_trajectory"]}}}}
    }
  ],
  "$defs": {
    "toolScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tools", "fixtures", "max_model_steps", "max_tool_calls"],
      "properties": {
        "schema_version": {"const": 1},
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/toolDefinition"}
        },
        "fixtures": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/toolFixture"},
          "description": "The one reviewed expected call path in order, with fixed outcomes consumed only by the local simulator."
        },
        "max_model_steps": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 16}
      }
    },
    "toolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "effect", "arguments_schema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1},
        "effect": {"enum": ["read_only", "state_changing"]},
        "arguments_schema": {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"const": "object"}}
        }
      }
    },
    "toolFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments", "result"],
      "properties": {
        "tool": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
        "arguments": {"type": "object"},
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "payload"],
          "properties": {
            "status": {"enum": ["success", "empty", "not_found", "unavailable", "permission_denied", "timeout", "error"]},
            "payload": {"type": "object"}
          }
        }
      }
    },
    "trustedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items"],
      "properties": {
        "schema_version": {"const": 1},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/trustedContextItem"}
        }
      }
    },
    "trustedContextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "status", "payload"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "A descriptive source label, not an executable tool name or capability allow-list entry."
        },
        "status": {
          "enum": ["success", "empty", "not_found", "unavailable", "permission_denied", "timeout", "error"]
        },
        "payload": {"type": "object"}
      }
    },
    "semanticOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "action", "arguments", "requires_clarification"],
      "properties": {
        "decision": {"enum": ["act", "no_action", "clarify", "respond"]},
        "action": {"type": ["string", "null"]},
        "arguments": {"type": "object"},
        "requires_clarification": {"type": "boolean"},
        "response_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement", "language"],
          "properties": {
            "requirement": {"enum": ["required", "optional", "forbidden"]},
            "language": {"enum": ["same_as_case", "en", "ja", "en_ja", "any"]}
          }
        },
        "presentation_intent": {
          "enum": ["none", "text", "media_results", "media_details", "playback_handoff", "confirmation"]
        },
        "tool_trajectory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calls", "completion"],
          "properties": {
            "calls": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tool", "arguments"],
                "properties": {
                  "tool": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
                  "arguments": {"type": "object"}
                }
              }
            },
            "completion": {"const": "final"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "act"}}, "required": ["decision"]},
          "then": {
            "properties": {
              "action": {"type": "string", "minLength": 1},
              "requires_clarification": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"decision": {"const": "clarify"}}, "required": ["decision"]},
          "then": {
            "properties": {
              "action": {"type": "null"},
              "arguments": {"maxProperties": 0},
              "requires_clarification": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"decision": {"enum": ["no_action", "respond"]}}, "required": ["decision"]},
          "then": {
            "properties": {
              "action": {"type": "null"},
              "arguments": {"maxProperties": 0},
              "requires_clarification": {"const": false}
            }
          }
        }
      ]
    }
  }
}
