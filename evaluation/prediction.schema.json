{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumi evaluation prediction record",
  "description": "A wrapper that retains the model's raw output, optional fixture-only trajectory, and optional human reviews so malformed structured responses remain countable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "raw_output"],
  "properties": {
    "schema_version": {"const": 3},
    "case_id": {"type": "string", "minLength": 1},
    "raw_output": {"type": "string", "description": "Raw UTF-8 JSON text for the final candidate output, or the terminal raw step when the trajectory does not reach a final output. Do not repair it before scoring."},
    "trajectory": {"$ref": "#/$defs/trajectory"},
    "grounding_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "reviewed"]},
        "claim_count": {"type": "integer", "minimum": 0},
        "unsupported_claim_count": {"type": "integer", "minimum": 0},
        "reviewer_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "reviewed"}}, "required": ["status"]},
          "then": {"required": ["claim_count", "unsupported_claim_count", "reviewer_id"]}
        }
      ]
    },
    "response_review": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {"status": {"const": "pending"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer_id", "language", "qualification", "naturalness_status", "meaning_preservation_status", "intent_appropriateness_status", "conciseness_status"],
          "properties": {
            "status": {"const": "reviewed"},
            "reviewer_id": {"type": "string", "minLength": 1, "description": "Stable pseudonymous reviewer ID, not a personal name."},
            "language": {"enum": ["en", "ja", "en_ja"]},
            "qualification": {"enum": ["native_english", "fluent_english", "native_japanese", "fluent_japanese", "fluent_bilingual"]},
            "naturalness_status": {"enum": ["approved", "needs_revision"]},
            "meaning_preservation_status": {"enum": ["approved", "needs_revision"]},
            "intent_appropriateness_status": {"enum": ["approved", "needs_revision"]},
            "conciseness_status": {"enum": ["approved", "needs_revision"]}
          }
        }
      ]
    }
  },
  "$defs": {
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments"],
      "properties": {
        "tool": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
        "arguments": {"type": "object"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "payload", "simulated", "effect"],
      "properties": {
        "status": {"enum": ["success", "empty", "not_found", "unavailable", "permission_denied", "timeout", "error", "unknown_tool", "fixture_mismatch", "call_limit"]},
        "payload": {"type": "object"},
        "simulated": {"const": true},
        "effect": {"enum": ["read_only", "state_changing", "unknown"]}
      }
    },
    "trajectoryStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_output", "tool_call", "observation"],
      "properties": {
        "raw_output": {"type": "string"},
        "tool_call": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/toolCall"}
          ]
        },
        "observation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/observation"}
          ]
        }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "stop_reason", "steps"],
      "properties": {
        "schema_version": {"const": 1},
        "stop_reason": {"enum": ["final", "invalid_tool_call", "call_limit", "step_limit"]},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/trajectoryStep"}
        }
      }
    }
  }
}
